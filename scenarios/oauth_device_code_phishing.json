        "item_type": "Mail",
        "user_key": "{{RANDOM_EMAIL}}",
        "ClientIP": "{{CNC_IP}}",
        "multiply": 100,
        "is_malicious": true,
        "mitre": {
          "tactic": "Collection",
          "technique_id": "T1114.002",
          "technique_name": "Email Collection: Remote Email Collection"
