        "source": "security_alert",
        "event_type": "security_alert",
        "alert_name": "Device Code Authentication Phishing Detected",
        "alert_type": "OAuth Abuse",
        "severity": "High",
        "description": "User {{RANDOM_USER}}@litware.com completed device code authentication from unknown app. Refresh token with Mail.ReadWrite and Files.ReadWrite.All scopes issued to client ID starting with ab1c2d3e. Source IP {{CNC_IP}} is associated with known phishing infrastructure. Subsequent Graph API calls detected from same IP with 100+ mailbox reads.",
        "confidence_level": "High",
        "confidence_score": 0.92,
        "tactics": "['Initial Access', 'Credential Access', 'Collection', 'Persistence']",
        "techniques": "['T1566.002', 'T1525', 'T1528', 'T1114.002', 'T1136.003']",
        "compromised_entity": "{{RANDOM_USER}}@litware.com",
        "remediation_steps": "Revoke all refresh tokens issued to the malicious app, disable device code authentication for non-admin users, investigate Azure AD audit logs for service principal creation, rotate affected credentials",
